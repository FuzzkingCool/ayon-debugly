# Copy to `.env` and fill in. Do not commit real secrets.
# Used by `scripts/test_notion_properties.py` and `scripts/test_notion_upload.py`.

# Notion integration token (Bearer). Create at https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_replace_with_your_integration_secret

# Target database ID (32 hex chars, with or without dashes).
# Optional `?v=<uuid>` when pasting from Notion: preferred data_source id if it matches
# the database’s data_sources list (see Notion API 2025-09-03+ multi-source databases).
NOTION_DB_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa?v=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
